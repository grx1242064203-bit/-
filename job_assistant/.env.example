# 飞书商店应用凭证(open.feishu.cn 创建后获取)
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 飞书事件订阅安全校验(生产强烈建议配置)
FEISHU_VERIFICATION_TOKEN=xxxxxxxx
# FEISHU_ENCRYPT_KEY=xxxxxxxx

# WxPusher 应用 Token(已降级为可选辅助通道,主推送走飞书)
WXPUSHER_APP_TOKEN=AT_xxxxxxxxxxxxxxxxxxxxx
# 管理员 WxPusher UID — 每日任务失败时向其推送告警(可选)
ADMIN_WXPUSHER_UID=UID_xxxxxxxxxxxxxxxxxxxxx

# LLM 配置(DeepSeek — 简历解析 + 岗位拆分 + JD 分析)
# 在 https://platform.deepseek.com 注册后获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx

# 数据存储目录
DATA_DIR=./data

# 服务域名(用于生成客户配置页链接,默认生产域名)
SERVICE_BASE_URL=https://zhaopin-helper.xyz
