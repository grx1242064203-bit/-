# ====== Offer搭子 API 环境变量 ======
# 复制为 .env 后按需填写。生产部署 ⚠️ 标记的项必须覆盖。

# DeepSeek（LLM 简历解析 / JD 评分 / 公司尽调）⚠️
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM 每用户每日调用配额
#   -1 = 不限制（仅开发用，生产会账单失控）
#    0 = 禁用
#    N = 限制 N 次/天（生产建议 5-20）
LLM_DAILY_LIMIT=10

# JWT 鉴权 ⚠️
# 生产必须改为随机长字符串，生成方法：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-prod
JWT_ALG=HS256
JWT_EXPIRE_HOURS=168

# Resend 邮件（注册验证码发送）
# 未配置则邮箱验证码无法发送（注册/登录功能不可用）
# 申请：https://resend.com/  每月免费 3000 封
RESEND_API_KEY=
# 发件人地址：用自有域名（如 noreply@yourdomain.com），需先在 Resend 控制台验证域名
# 不填用 Resend 沙箱地址 onboarding@resend.dev（只能发到注册 Resend 的邮箱，仅测试用）
RESEND_FROM_EMAIL=onboarding@resend.dev

# 管理员邮箱（私域获客场景）
# 你用自己的邮箱注册一次后，启动时自动标记为管理员，可访问 /api/v1/admin/* 管理后台
# 留空则不自动标记，需手动改数据库（不推荐）
ADMIN_EMAIL=

# 邮箱账户密码加密密钥（Fernet 对称加密）⚠️
# 用于加密用户存的 IMAP 邮箱密码。未配置则用进程临时密钥，重启后已存邮箱密码失效。
# 生成方法：
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=

# 认证接口限流（每 IP 每分钟，slowapi 字符串格式）
AUTH_RATE_LIMIT_LOGIN=20/minute
AUTH_RATE_LIMIT_REGISTER=10/minute
AUTH_RATE_LIMIT_VERIFY=10/minute

# ============================================================================
# Vibe Pay 基础收款能力（支付宝 alipay.trade.page.pay 网页支付）
# 个人开发者可用，有沙箱环境。沙箱密钥由 aipay.alipay.com/open-flow 自动分配。
# 沙箱网关: https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 生产网关: https://openapi.alipay.com/gateway.do
# ============================================================================
# 环境开关: sandbox（沙箱，默认）/ production（生产）
ALIPAY_ENV=sandbox
# 应用 ID（沙箱/生产不同，由开放平台分配）
ALIPAY_APP_ID=
# 应用私钥（PKCS1 格式，非 Java；用支付宝官方密钥工具生成）
# 注意：私钥只在服务端 .env，绝不下发 Tauri 客户端
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（由开放平台分配，用于验签异步通知）
ALIPAY_PUBLIC_KEY=
# 异步通知 URL（公网 HTTPS，由支付宝服务端 POST 调用）
ALIPAY_NOTIFY_URL=https://zhaopin-helper.xyz/api/v1/payments/notify
# 同步回跳 URL（GET，不可信，仅用于 UX；前端路由接管）
ALIPAY_RETURN_URL=https://zhaopin-helper.xyz/pay-verify
# 商品价格（分），可被 .env 覆盖
ALIPAY_PRODUCT_TRIAL_CENTS=990
ALIPAY_PRODUCT_TRIAL_DAYS=30
ALIPAY_PRODUCT_LIFETIME_CENTS=9900

# 数据存储
DATA_DIR=../data
JOBS_DB_PATH=../data/jobs.db
AUTH_DB_PATH=../data/auth.db

# 远程主库（服务器 jobs.db 同步源）⚠️
# 生产必须 HTTPS，避免中间人投毒
REMOTE_DB_BASE_URL=https://your-server-domain
REMOTE_DB_INFO_PATH=/api/db/info
REMOTE_DB_DOWNLOAD_PATH=/api/db/download

# CORS 允许源（JSON 数组字符串）
# 开发期默认 ["*"]；生产应改为前端域名白名单，如 ["https://your-app.com"]
CORS_ORIGINS=["*"]
