# ====== Offer搭子 API 环境变量 ======
# 复制为 .env 后按需填写。生产部署 ⚠️ 标记的项必须覆盖。

# DeepSeek（LLM 简历解析 / JD 评分 / 公司尽调）⚠️
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM 每用户每日调用配额
#   -1 = 不限制（仅开发用，生产会账单失控）
#    0 = 禁用
#    N = 限制 N 次/天（生产建议 5-20）
LLM_DAILY_LIMIT=10

# JWT 鉴权 ⚠️
# 生产必须改为随机长字符串，生成方法：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-prod
JWT_ALG=HS256
JWT_EXPIRE_HOURS=168

# Resend 邮件（注册验证码发送）
# 未配置则邮箱验证码无法发送（注册/登录功能不可用）
# 申请：https://resend.com/  每月免费 3000 封
RESEND_API_KEY=
# 发件人地址：用自有域名（如 noreply@yourdomain.com），需先在 Resend 控制台验证域名
# 不填用 Resend 沙箱地址 onboarding@resend.dev（只能发到注册 Resend 的邮箱，仅测试用）
RESEND_FROM_EMAIL=onboarding@resend.dev

# 管理员邮箱（私域获客场景）
# 你用自己的邮箱注册一次后，启动时自动标记为管理员，可访问 /api/v1/admin/* 管理后台
# 留空则不自动标记，需手动改数据库（不推荐）
ADMIN_EMAIL=

# 邮箱账户密码加密密钥（Fernet 对称加密）⚠️
# 用于加密用户存的 IMAP 邮箱密码。未配置则用进程临时密钥，重启后已存邮箱密码失效。
# 生成方法：
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=

# 认证接口限流（每 IP 每分钟，slowapi 字符串格式）
AUTH_RATE_LIMIT_LOGIN=20/minute
AUTH_RATE_LIMIT_REGISTER=10/minute
AUTH_RATE_LIMIT_VERIFY=10/minute

# 数据存储
DATA_DIR=../data
JOBS_DB_PATH=../data/jobs.db
AUTH_DB_PATH=../data/auth.db

# 远程主库（服务器 jobs.db 同步源）⚠️
# 生产必须 HTTPS，避免中间人投毒
REMOTE_DB_BASE_URL=https://your-server-domain
REMOTE_DB_INFO_PATH=/api/db/info
REMOTE_DB_DOWNLOAD_PATH=/api/db/download

# CORS 允许源（JSON 数组字符串）
# 开发期默认 ["*"]；生产应改为前端域名白名单，如 ["https://your-app.com"]
CORS_ORIGINS=["*"]
